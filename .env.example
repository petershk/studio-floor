# Copy to .env beside docker-compose.yml and fill in. Compose reads it
# automatically; `.env` is gitignored and `.env.example` is not, so keep every
# real value on the left of that line.
#
#   cp .env.example .env
#   docker compose up -d --build

# ---------------------------------------------------------------- required

# The only thing between a stranger and agents that run shell commands as root
# in this container. Every /api/* route is refused without it.
#
#   openssl rand -hex 32
STUDIO_TOKEN=

# ------------------------------------------------------ provider credentials

# Set the ones your roster actually uses; the vendor CLIs read these
# themselves. Prefer keys scoped to one project with a spend cap over copying
# an interactive login onto a remote host.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ------------------------------------------------------------------- git

# Needed to clone private repositories, and to let the team push branches.
# A fine-grained token, scoped to the repositories you want the team inside:
# contents:read to clone, contents:write to push. Anything in the container can
# use it, so scope it to repositories you would not mind an agent having a bad
# day in.
#
# Leave empty and the team commits locally only, which it is told about.
STUDIO_GIT_TOKEN=

# Who the commits are by, when the box has no git identity of its own.
STUDIO_GIT_NAME=Studio Floor
STUDIO_GIT_EMAIL=studio-floor@localhost

# ---------------------------------------------------------------- exposure

# Only needed for `docker compose --profile tunnel up -d`. Created in the
# Cloudflare dashboard: Zero Trust -> Networks -> Tunnels. Put an Access policy
# on the hostname as well, or the tunnel publishes the studio to the internet
# with STUDIO_TOKEN as its only guard.
TUNNEL_TOKEN=
